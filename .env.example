# Apenas URL e chave PUBLICÁVEL no navegador. Nunca service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Lovable usa rotas da aplicação; em Supabase independente, deixe vazio para usar Edge Functions.
VITE_ENGINE_URL=
VITE_REWRITE_URL=
# Motor: URL da função engine-api, credencial emitida no painel, chave AES de 32 bytes em base64.
ENGINE_URL=
ENGINE_TOKEN=
ENGINE_SESSION_KEY=
ENGINE_DATA_DIR=.engine-data
# Real é iniciado apenas com esta seleção explícita. Não use mock em produção.
ENGINE_TRANSPORT=baileys
# Opcional: permite operar somente a conta desse número, com DDI. Não vincula automaticamente.
ENGINE_EXPECTED_PHONE=
